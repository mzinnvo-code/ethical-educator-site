{
  "name": "examined-classroom-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run prerender && cp dist/index.html dist/404.html && node scripts/generate-feeds.mjs && node scripts/generate-og-images.mjs",
    "test": "node --test src/data/*.test.mjs src/pages/home/*.test.mjs",
    "test:rebrand": "node scripts/check-rebrand.mjs",
    "test:crawlability": "node scripts/check-crawlability.mjs",
    "og:generate": "node scripts/generate-og-images.mjs",
    "visuals:check": "node scripts/check-stage-visuals.mjs",
    "prerender": "node scripts/prerender-site.mjs",
    "seo:indexnow": "node scripts/submit-indexnow.mjs",
    "seo:offsite-check": "node scripts/check-offsite-seo.mjs",
    "report:site": "node scripts/site-review.mjs",
    "preview": "vite preview",
    "audio:generate": "node --env-file=.env.local scripts/generate-k5-audio.mjs",
    "audio:scene": "node --env-file=.env.local scripts/generate-scene-audio.mjs",
    "optimize-images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "minisearch": "^7.2.0",
    "motion": "^12.40.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "sharp": "^0.34.5",
    "vite": "^5.4.0"
