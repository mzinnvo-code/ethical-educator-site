{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "examined-classroom-events",
  "main": "src/index.js",
  "compatibility_date": "2026-05-20",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "analytics_engine_datasets": [
    {
      "binding": "EVENTS",
      "dataset": "examined_classroom_events"
    }
  ]
}
